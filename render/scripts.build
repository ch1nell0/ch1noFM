"scripts": {
  "build": "echo '--- STEP node/npm version ---' && node -v && npm -v && echo '--- STEP pip plugin ---' && pip install -U bgutil-ytdlp-pot-provider && echo '--- STEP npm install app ---' && npm install && echo '--- STEP git clone bgutil ---' && rm -rf bgutil-server-src && git clone --depth 1 --branch 1.3.1 https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git bgutil-server-src && echo '--- STEP npm ci bgutil server ---' && cd bgutil-server-src/server && npm ci && echo '--- STEP npm run build bgutil server ---' && npm run build && cd ../.. && echo '--- STEP bgutil OK, main.js dovrebbe esistere ---' || echo '!!! BUILD BGUTIL FALLITA (vedi step sopra), continuo senza PO Token !!!'",
  "start": "node index.js"
}"scripts": {
  "build": "npm install && npx yt-dlp-exec --update",
  "start": "node server.js"
}
